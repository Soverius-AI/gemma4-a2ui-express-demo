{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "a2ui-express": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/a2ui-express",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "webWorkerTsConfig": "tsconfig.worker.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "{LICENSE,THIRD_PARTY_NOTICES.md}",
                "input": ".",
                "output": "."
              },
              {
                "glob": "**/*",
                "input": "notices",
                "output": "notices"
              }
            ],
            "styles": ["@copilotkit/angular/styles.css", "src/styles.css"],
            "allowedCommonJsDependencies": [
              "partial-json",
              "semver",
              "validate-color"
            ]
          },
          "configurations": {
            "production": {
              "optimization": true,
              "sourceMap": false,
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "sourceMap": true,
              "extractLicenses": false
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "a2ui-express:build:production"
            },
            "development": {
              "buildTarget": "a2ui-express:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      },
      "prefix": "app"
    }
  },
  "cli": {
    "analytics": false
  }
}
